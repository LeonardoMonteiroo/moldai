# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
/.playwright-mcp/

# playwright — local test-account credentials and saved storageState.
# Real values for a throwaway account on a local database; never commit.
/playwright/.auth/

# claude code — commit settings.json / hooks / agents / skills (team-wide),
# but never the personal override file: it is the usual place for credentials
# and is NOT covered by any other rule here.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock
