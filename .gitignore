# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest blob reports — what `--reporter=blob` writes so a split test run can
# be merged back into one report (CI's test-node/test-dom -> coverage jobs).
/.vitest-reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
/.playwright-mcp/

# ux review screenshots — taken of the running app (often while logged in)
# for per-issue backlog evidence; regenerate on every review pass and must
# never land in history.
/ux-*.png

# playwright — local test-account credentials and saved storageState.
# Real values for a throwaway account on a local database; never commit.
/playwright/.auth/

# claude code — commit settings.json / hooks / agents / skills (team-wide),
# but never the personal override file: it is the usual place for credentials
# and is NOT covered by any other rule here.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock

# #269 — scripts/distill-training-data.ts's and
# scripts/generate-training-data.ts's own output: synthetic (prompt,
# GarmentSpec) pairs, spending real Anthropic tokens each run. Local tooling
# output, not a repo asset -- same reasoning as /coverage above. Commit a
# sample deliberately if one is ever needed for review; never by default.
/data/training/

# #269 Fase 5 — scripts/lora/prepare_dataset.py's own output: the chat-format
# SFT dataset (and its held-out validation split) built from
# /data/training/*.jsonl above. Same "local tooling output" reasoning; the
# training host, not this repo, is where these files matter.
/scripts/lora/dataset.jsonl
/scripts/lora/dataset.jsonl.val.jsonl

# #269 Fase 5 — a real training/eval-gate run's own local artifacts: trained
# adapter weights (large, rented-GPU output), and the experimental eval
# reports/run logs a gate check produces. Never the committed
# docs/reference/ai-eval/report.md baseline, which a gate run always
# restores via `git checkout` when it's done comparing.
/scripts/lora/lora-checkpoints/
/scripts/lora/lora-out-final/
/scripts/lora/eval-base-report.md
/scripts/lora/eval-lora-report.md
/scripts/lora/eval-base-run.log
/scripts/lora/eval-lora-run.log
/scripts/lora/report-anthropic-baseline.md

# design-sync — staged converter scripts, generated bundle output and
# machine-local verification state; .design-sync/config.json, NOTES.md,
# conventions.md, previews/ and overrides/ ARE committed (see .design-sync/NOTES.md)
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
/.ds-entry.ts
