# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest blob reports — what `--reporter=blob` writes so a split test run can
# be merged back into one report (CI's test-node/test-dom -> coverage jobs).
/.vitest-reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
/.playwright-mcp/

# ux review screenshots — taken of the running app (often while logged in)
# for per-issue backlog evidence; regenerate on every review pass and must
# never land in history.
/ux-*.png

# playwright — local test-account credentials and saved storageState.
# Real values for a throwaway account on a local database; never commit.
/playwright/.auth/

# claude code — commit settings.json / hooks / agents / skills (team-wide),
# but never the personal override file: it is the usual place for credentials
# and is NOT covered by any other rule here.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock

# playwright-skill — installed dependencies and its own per-run scratch
# scripts, both generated locally by run.js; only SKILL.md/lib/run.js/
# package.json are part of the skill itself.
/.claude/skills/playwright-skill/node_modules/
/.claude/skills/playwright-skill/package-lock.json
/.claude/skills/playwright-skill/.temp-execution-*.js

# design-sync — staged converter scripts, generated bundle output and
# machine-local verification state; .design-sync/config.json, NOTES.md,
# conventions.md, previews/ and overrides/ ARE committed (see .design-sync/NOTES.md)
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
/.ds-entry.ts
