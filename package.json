{
  "name": "moldai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next build",
    "db:up": "docker compose --env-file .env.local up -d db redis",
    "docker:up": "docker compose --env-file .env.local up --build",
    "docker:prod": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.prod.yml up --build",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "cron:renew": "dotenv -e .env.local -- tsx scripts/cron-renew.ts",
    "backfill:freesewing": "dotenv -e .env.local -- tsx scripts/backfill-freesewing-measurements.ts",
    "smoke": "node scripts/smoke-prod.mjs",
    "smoke:prod": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.prod.yml up -d --build && node scripts/smoke-prod.mjs",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{js,mjs,cjs,json,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/prisma-adapter": "^2.11.3",
    "@freesewing/config": "4.10.1",
    "@freesewing/core": "4.10.1",
    "@freesewing/diana": "4.10.1",
    "@freesewing/plugin-transform": "4.10.1",
    "@freesewing/teagan": "4.10.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@freesewing/models": "4.10.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
