# Copy to .env.local and fill in. Nothing here is read at build time; the Docker
# stack passes .env.local in at runtime via env_file, never baked into the image.
# The npm docker scripts also pass this file as --env-file, so Compose itself
# (not just the containers) can resolve the ${POSTGRES_PASSWORD}/${REDIS_PASSWORD}
# interpolations in docker-compose.yml -- env_file: alone only reaches the
# container's runtime environment, not Compose's own variable substitution.

# --- required ---
# #25: no default in docker-compose.yml -- `docker compose up` fails loudly
# if this is unset rather than silently using a weak, previously-committed
# password. Must match the password half of DATABASE_URL below (Postgres'
# own container bootstraps with this value; DATABASE_URL is a separate
# connection string that has to carry the same value to authenticate).
# Generate with: openssl rand -hex 20
POSTGRES_PASSWORD=
# Host: localhost:5433. Inside the Docker network: db:5432. The password
# here must be the same value as POSTGRES_PASSWORD above.
# Every /generate request holds one connection inside a transaction for the
# full Anthropic call (up to the 30s TX_OPTS timeout in lib/db/pattern.ts),
# not just for a quick query -- so Prisma's default pool
# (num_physical_cpus*2+1) can be exhausted by a handful of concurrent
# generations, with the rest failing on pool_timeout. Size it for expected
# concurrent generations, e.g. append ?connection_limit=20&pool_timeout=20.
DATABASE_URL=postgresql://moldai:<same as POSTGRES_PASSWORD>@localhost:5433/moldai?schema=public
# Any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=
ANTHROPIC_API_KEY=

# --- email verification ---
# Absolute base for the links mailed to users. No trailing slash.
APP_URL=http://localhost:3000
# Leave SMTP_HOST unset outside production and the verification link is logged
# to the server console instead of mailed. In production, unset makes sign-up
# fail with mail_unavailable rather than silently dropping the mail.
# `npm run docker:up` points these at Mailpit automatically (inbox at :8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MoldAI <no-reply@moldai.local>

# --- rate limiting ---
# #25: same "no default, fails loudly if unset" reasoning as
# POSTGRES_PASSWORD -- an unauthenticated Redis published to the host lets
# anyone FLUSHALL (silently disables all rate limiting) or use CONFIG SET
# dir/dbfilename (a known RCE primitive). Generate with: openssl rand -hex 20
REDIS_PASSWORD=
# Host: localhost:6380. Inside the Docker network: redis:6379. The password
# here must be the same value as REDIS_PASSWORD above.
# When unreachable the limiter fails open -- auth keeps working, unthrottled.
REDIS_URL=redis://:<same as REDIS_PASSWORD>@localhost:6380

# --- payment gateway (#6/#206) ---
# Selects how POST /api/billing/purchase behaves. Anything other than the
# literal string "stripe" -- unset, empty, a typo, or the now-removed
# "asaas" -- resolves to "mock", on purpose: a misconfigured flag must fail
# towards the harmless mock, never towards accidentally-enabled real
# charges. "mock" is byte-for-byte the pre-existing instant-credit behaviour
# (no gateway, no charge). "stripe" creates a real hosted Checkout Session
# and only credits a wallet from a later, signature-verified webhook -- see
# CLAUDE.md's Billing section for what is (and is NOT yet) verified against
# a real Stripe account.
PAYMENT_PROVIDER=mock
# Required only when PAYMENT_PROVIDER=stripe. Use a test-mode key
# (sk_test_...) until the whole flow has been round-tripped once.
# Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Required only when PAYMENT_PROVIDER=stripe -- loadStripeConfig() treats a
# missing webhook secret exactly like a missing API key and answers 503,
# because a deployment that can take money but cannot verify the webhook
# that credits it would charge the card and never deliver credits.
# Stripe mints this when you register POST {APP_URL}/api/billing/webhook as
# an endpoint (Dashboard > Developers > Webhooks); `stripe listen` prints a
# different one for local forwarding. Subscribe the endpoint to exactly:
#   checkout.session.completed, invoice.paid, charge.refunded
STRIPE_WEBHOOK_SECRET=

# --- reverse proxy (production deployments) ---
# #27: no env var here -- this is a requirement on whatever terminates TLS in
# front of `next start` (npm run docker:prod), documented because getting it
# wrong is silent. The proxy must:
#   1. Set x-forwarded-proto: https. Without it, Next/Auth.js see the
#      connection as http and auth.ts's useSecureCookies (gated on
#      NODE_ENV=production, not on this header) still issues a Secure
#      cookie -- but every other https-derived decision in the stack reads
#      this header, so a proxy that never sets it is a latent bug even
#      though the session cookie itself doesn't depend on it.
#   2. OVERWRITE x-forwarded-for, never append to a client-supplied one.
#      lib/rate-limit/ip.ts's clientIp() trusts this header as-is, and
#      CLAUDE.md's rate-limiting section already states this same
#      constraint for the IP-keyed buckets -- it's the identical proxy
#      config, restated here because this is the other place it matters.

# --- smoke test ---
# Only read by scripts/smoke-prod.mjs (npm run smoke / smoke:prod), never
# by the app itself. There is no seed script -- create the account through
# /signup like any other, confirm it (Mailpit at :8025 in the dev stack),
# then point these at it. SMOKE_EMAIL/SMOKE_PASSWORD are required: the
# script fails fast with a named error if either is unset, rather than
# posting stale/nonexistent credentials and reporting a generic
# "login rejected" indistinguishable from a real auth regression.
SMOKE_URL=http://localhost:3000
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_READY_TIMEOUT_MS=120000
