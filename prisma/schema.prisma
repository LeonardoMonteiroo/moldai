datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  // #235: nullable -- a Google-only account (no Credentials signup) has no
  // password at all. authorizeUser (lib/auth/authorize.ts) returns a
  // dedicated `no_password` reason for a Credentials attempt against one,
  // rather than comparing against nothing. /settings' PasswordSection lets
  // such an account set a password once (see lib/account/settings.ts).
  passwordHash        String?
  name                String?
  // #235: required by @auth/prisma-adapter's createUser -- Google's OAuth
  // profile includes an avatar URL, and PrismaAdapter passes it straight
  // into `prisma.user.create`. Written, never read by any screen today.
  image               String?
  emailVerified       DateTime?
  createdAt           DateTime                 @default(now())
  // #29: nullable and additive -- NULL honestly means "never changed since
  // this column existed," not a fabricated backfill timestamp. Stamped in
  // the same write as the hash update (lib/db/users.ts's
  // updateUserPasswordHash), so a successful change can't be recorded
  // without the hash actually changing, and vice versa. Doubles as the
  // timestamp a future "sign out everywhere" revocation check would read.
  passwordChangedAt   DateTime?
  // #14: post-signup onboarding wizard tracking, additive. onboardedAt gates
  // app/page.tsx's redirect to /onboarding by null-ness only -- existing
  // rows are backfilled to "already onboarded" by this migration (the
  // 20260820120000_add_email_verification precedent: a bare nullable column
  // with no backfill would trap every established account in a wizard meant
  // only for new signups). workStyle is honest, unused research data from
  // step 1 (lib/db/users.ts's WorkStyle) -- never read by any drafting or
  // behaviour path.
  onboardedAt         DateTime?
  workStyle           String?
  // #235: Auth.js account-linking. A Credentials-only user has zero rows
  // here; a Google sign-in gets exactly one, added by the adapter itself.
  accounts            Account[]
  // #235: standard adapter shape, never actually written -- this app keeps
  // JWT sessions (session.strategy: "jwt" in auth.ts), so no database
  // Session row is ever created. Kept only because @auth/prisma-adapter is
  // typed against the full standard schema.
  sessions            Session[]
  patterns            Pattern[]
  wallet              Wallet?
  sizeCharts          SizeChart[]              @relation("UserSizeCharts")
  slopers             Sloper[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  // #71: was a bare scalar with no FK, so a crash between deleteSizeChart's
  // two writes could leave this naming a row that no longer exists -- the
  // pointer degraded quietly (every read site treats a dangling id as "no
  // active chart") rather than being rejected. onDelete: SetNull makes
  // Postgres null it whenever the chart it names is deleted, which is also
  // what deleteSizeChart's own $transaction now does at the app level --
  // this closes the same hole at the schema level, unconditionally.
  activeSizeChartId   String?
  activeSizeChart     SizeChart?               @relation("ActiveSizeChart", fields: [activeSizeChartId], references: [id], onDelete: SetNull)
  // #17: the export screen's "Salvar preset" -- one preset per account
  // (design 5h has no per-pattern or multi-preset concept), additive and
  // nullable so NULL honestly means "never saved," distinct from "saved,
  // every field at its default." Not a new table: SizeChart/Sloper/Wallet
  // are all one-row-per-entity JSON blobs, but there is only ever one of
  // these per account, so a bare scalar on User (the activeSizeChartId
  // precedent for a small account-level value) fits without the extra
  // ownership-scoped CRUD a table would need. Untrusted on read exactly
  // like SizeChart.data -- lib/db/exportPreset.ts revalidates through
  // lib/export/preset.ts's validateExportPreset (drop-or-clamp,
  // never-throw) before this ever reaches the export screen.
  exportPreset        Json?
  // #232: dashboard onboarding checklist's "exportar um PDF" / "importar
  // moldes existentes" steps. Both flows are otherwise client-side with no
  // server trace at all, so these are a minimal, additive "this happened
  // once" signal -- not a full audit log, never rewritten once set. Null
  // means "not known to have happened," including for every existing
  // account: their real history before this column existed is genuinely
  // unknowable, so there is no backfill (the onboardedAt precedent's
  // backfill doesn't apply -- there the alternative was re-trapping every
  // established account in a wizard; here it's just one checklist row
  // staying unchecked for something an old account may have already done,
  // low-severity and dismissable anyway).
  firstExportedAt     DateTime?
  firstImportedAt     DateTime?

  @@index([activeSizeChartId])
}

// #235: real and load-bearing -- this is how a Google identity resolves to
// a User.id. @@unique([provider, providerAccountId]) is what the adapter's
// getUserByAccount looks up on every Google sign-in.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// #235: standard Auth.js adapter shape, kept for contract compatibility --
// never written to. This app keeps JWT sessions (no database Session row is
// ever created) and already has its own EmailVerificationToken/
// PasswordResetToken (Auth.js's own VerificationToken backs its Email/
// magic-link provider only, which this app doesn't use). Two empty tables
// are the conscious cost of choosing the full adapter over a lightweight
// column -- see docs/decisions/auth.md.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  tokenHash String   @id // sha-256 of the raw token, hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// #24: shaped identically to EmailVerificationToken -- same token primitives
// (lib/auth/verification.ts's newVerificationToken/hashToken), same
// single-use/newest-only issuance (lib/db/passwordReset.ts mirrors
// lib/db/verification.ts). A separate table rather than reusing
// EmailVerificationToken because the two have different consumers (email
// confirmation vs. a password change) and different lifecycles -- issuing
// one must never invalidate the other.
model PasswordResetToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Pattern {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  // #16: back-relation for PatternVersion below. Cascades away with the
  // Pattern (onDelete: Cascade is declared on PatternVersion's own side) --
  // deleting a pattern must take its history with it, matching every other
  // relation in this schema.
  versions  PatternVersion[]

  @@index([userId, updatedAt])
}

// #68: the DB also carries a partial unique index on (userId, data->>'gender')
// WHERE (data->>'isSystem')::boolean, added by raw SQL in migration
// 20260823120000 -- Prisma cannot express a partial index over a JSON path,
// so it is NOT declared here. If `npm run db:migrate` (prisma migrate dev)
// ever proposes a migration that drops "SizeChart_userId_systemGender_key"
// to "fix" this drift, DECLINE IT -- that index is what keeps
// ensureSystemSizeCharts' concurrent seeding race-safe (lib/db/sizeChart.ts).
model SizeChart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSizeCharts", fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  // Back-relation for User.activeSizeChart above. Modeled as a list because
  // Prisma requires it on this side of a one-to-many FK, but in practice at
  // most one User ever names a given chart -- setActiveSizeChart only ever
  // points a user's pointer at a chart that same user owns.
  activeFor User[]   @relation("ActiveSizeChart")

  @@index([userId, updatedAt])
}

model Sloper {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model Wallet {
  userId              String        @id
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                String
  balance             Int
  total               Int
  purchased           Int           @default(0)
  renewsAt            DateTime?
  // Annual billing (docs/superpowers/specs/2026-08-30-annual-billing-design.md):
  // which cycle backs the wallet's CURRENT plan/total. Additive, no backfill
  // needed -- every existing row (free or monthly-paid) is correctly "month".
  planInterval        String        @default("month")
  updatedAt           DateTime      @updatedAt
  // #206: real-gateway identity, additive and both nullable -- every
  // existing wallet (and every wallet created while PAYMENT_PROVIDER=mock,
  // the default) simply never gets these set. stripeCustomerId is written
  // once, lazily, on a user's first Stripe checkout (lib/db/wallet.ts's
  // withStripeCustomerId). stripeSubscriptionId is written by the
  // invoice.paid/subscription_create webhook, INSIDE the same transaction
  // as the credit it accompanies (unlike the deleted asaas column's
  // best-effort write after the fact) -- scripts/cron-renew.ts excludes
  // wallets carrying one, so losing it would silently hand a subscribed
  // wallet back to the free-tier cron and double-renew it.
  //
  // These replaced asaasCustomerId/asaasSubscriptionId in migration
  // 20260827180000_replace_asaas_with_stripe. No backfill: Asaas never ran
  // against a real account, so no row ever held either value.
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  // #196: the externalId of the Transaction row that currently backs this
  // wallet's plan/total -- see lib/billing/wallet.ts's Wallet.planSourceExternalId
  // doc comment for the full reasoning. Additive/nullable, written only by
  // lib/db/wallet.ts's withWalletIdempotent (so only ever set for a
  // gateway-originated, plan-CHANGING subscribe entry -- the mock purchase
  // path has no externalId to point at and never sets this). Migration
  // 20260827130000_add_wallet_plan_source backfills it (and Transaction's
  // sibling planChanged column) for every wallet already on a paid plan,
  // best-effort -- see that migration's own comment for the known limit.
  planSourceExternalId String?
  transactions        Transaction[]
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  wallet       Wallet   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int
  reason       String?
  // #6: the gateway's own payment/event id. The UNIQUE constraint IS the
  // idempotency story -- Stripe guarantees at-least-once webhook delivery, so
  // the same PAYMENT_CONFIRMED WILL arrive twice, and a duplicate insert
  // hitting this constraint (caught as Prisma P2002 in
  // lib/db/wallet.ts's withWalletIdempotent) is what makes the second
  // delivery a no-op instead of a double credit. Null for every ledger row
  // that isn't gateway-originated (debit/refund/renew, and the mock
  // purchase path).
  externalId   String?  @unique
  // #196: true only for a "subscribe" row that actually moved plan/total
  // (applyPurchase's upgrade branch) -- false for every other row, including
  // a "subscribe" that folded into `purchased` instead (the #193 guard).
  // See lib/billing/wallet.ts's LedgerEntry.planChanged doc comment.
  planChanged  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// #16: a version-history snapshot, recorded automatically inside the SAME
// transaction as every bumpVersion (generate/apply, graduate, "Corrigir
// manga", restore itself) -- so a row can never exist without the state that
// produced it, and a failed mutation leaves no orphan snapshot.
//
// Stores the GarmentSpec plus the frozen size snapshot ONLY -- never the
// drafted pieces. draftGarment(spec, sizeTable[baseSize], t) is deterministic
// (the same reasoning CLAUDE.md records for Sloper, whose round-trip test is
// what licenses not storing geometry), so persisting pieces here would
// duplicate exactly what spec+sizeTable already determine.
//
// userId is denormalized (also reachable via pattern.userId) so ownership can
// be checked with a single indexed lookup, matching Transaction.userId's own
// shape above.
model PatternVersion {
  id            String   @id @default(cuid())
  patternId     String
  pattern       Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  userId        String
  version       Int
  spec          Json
  sizes         Json
  baseSize      String
  sizeTable     Json
  sizeChartName String?
  // Machine-readable: "generate" | "adjust" | "graduate" | "conflict_fix" |
  // "restore". Never pt-BR prose -- the client resolves it through the
  // catalog, the wire-error-codes precedent.
  reason        String
  cost          Int
  createdAt     DateTime @default(now())

  @@unique([patternId, version])
  @@index([patternId, version])
}
