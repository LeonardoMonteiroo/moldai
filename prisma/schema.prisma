datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String?
  emailVerified      DateTime?
  createdAt          DateTime                 @default(now())
  patterns           Pattern[]
  wallet             Wallet?
  sizeCharts         SizeChart[]
  slopers            Sloper[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  activeSizeChartId  String?
}

model EmailVerificationToken {
  tokenHash String   @id // sha-256 of the raw token, hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// #24: shaped identically to EmailVerificationToken -- same token primitives
// (lib/auth/verification.ts's newVerificationToken/hashToken), same
// single-use/newest-only issuance (lib/db/passwordReset.ts mirrors
// lib/db/verification.ts). A separate table rather than reusing
// EmailVerificationToken because the two have different consumers (email
// confirmation vs. a password change) and different lifecycles -- issuing
// one must never invalidate the other.
model PasswordResetToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Pattern {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

// #68: the DB also carries a partial unique index on (userId, data->>'gender')
// WHERE (data->>'isSystem')::boolean, added by raw SQL in migration
// 20260823120000 -- Prisma cannot express a partial index over a JSON path,
// so it is NOT declared here. If `npm run db:migrate` (prisma migrate dev)
// ever proposes a migration that drops "SizeChart_userId_systemGender_key"
// to "fix" this drift, DECLINE IT -- that index is what keeps
// ensureSystemSizeCharts' concurrent seeding race-safe (lib/db/sizeChart.ts).
model SizeChart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model Sloper {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model Wallet {
  userId       String        @id
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String
  balance      Int
  total        Int
  purchased    Int           @default(0)
  renewsAt     DateTime?
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  wallet       Wallet   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
