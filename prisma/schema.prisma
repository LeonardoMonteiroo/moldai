datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  moldes       Molde[]
  wallet       Wallet?
}

model Molde {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model Wallet {
  userId       String        @id
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String
  planLabel    String
  balance      Int
  total        Int
  renewsAt     DateTime?
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  wallet       Wallet   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
