datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String?
  emailVerified      DateTime?
  createdAt          DateTime                 @default(now())
  patterns           Pattern[]
  wallet             Wallet?
  sizeCharts         SizeChart[]
  verificationTokens EmailVerificationToken[]
  activeSizeChartId  String?
}

model EmailVerificationToken {
  tokenHash String   @id // sha-256 of the raw token, hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Pattern {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model SizeChart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model Wallet {
  userId       String        @id
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String
  balance      Int
  total        Int
  renewsAt     DateTime?
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  wallet       Wallet   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
